FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

# Build-time parameters
ARG MONGODB_URI
ARG ENVIRONMENT
ARG NEXT_PUBLIC_APP_URL
ARG BASE_PATH
ARG API_SECRET
ARG LOG_LEVEL
ARG DOTCOM_SFMC_BASEURL
ARG DOTCOM_SFMC_AUTH_CONSUMER_ID
ARG DOTCOM_SFMC_AUTH_CONSUMER_SECRET
ARG APPLICATIONINSIGHTS_CONNECTION_STRING
ARG TIP_TOKEN
ARG NEW_RELIC_APP_NAME
ARG NEW_RELIC_LICENSE_KEY
ARG EMEID_AES_IV
ARG EMEID_AES_KEY

ENV MONGODB_URI=$MONGODB_URI \
    ENVIRONMENT=$ENVIRONMENT \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    BASE_PATH=$BASE_PATH \
    API_SECRET=$API_SECRET \
    LOG_LEVEL=$LOG_LEVEL \
    DOTCOM_SFMC_BASEURL=$DOTCOM_SFMC_BASEURL \
    DOTCOM_SFMC_AUTH_CONSUMER_ID=$DOTCOM_SFMC_AUTH_CONSUMER_ID \
    DOTCOM_SFMC_AUTH_CONSUMER_SECRET=$DOTCOM_SFMC_AUTH_CONSUMER_SECRET \
    APPLICATIONINSIGHTS_CONNECTION_STRING=$APPLICATIONINSIGHTS_CONNECTION_STRING \
    TIP_TOKEN=$TIP_TOKEN \
    NEW_RELIC_APP_NAME=$NEW_RELIC_APP_NAME \
    NEW_RELIC_LICENSE_KEY=$NEW_RELIC_LICENSE_KEY \
    EMEID_AES_IV=$EMEID_AES_IV \
    EMEID_AES_KEY=$EMEID_AES_KEY

RUN NODE_ENV=production npm run build

RUN npm prune --production


FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production

# Runtime parameters
ARG MONGODB_URI
ARG MONGODB_DB
ARG ENVIRONMENT
ARG NEXT_PUBLIC_APP_URL
ARG BASE_PATH
ARG API_SECRET
ARG LOG_LEVEL
ARG DOTCOM_SFMC_BASEURL
ARG DOTCOM_SFMC_AUTH_CONSUMER_ID
ARG DOTCOM_SFMC_AUTH_CONSUMER_SECRET
ARG APPLICATIONINSIGHTS_CONNECTION_STRING
ARG TIP_TOKEN
ARG NEW_RELIC_APP_NAME
ARG NEW_RELIC_LICENSE_KEY
ARG EMEID_AES_IV
ARG EMEID_AES_KEY

ENV MONGODB_URI=$MONGODB_URI \
    MONGODB_DB=$MONGODB_DB \
    ENVIRONMENT=$ENVIRONMENT \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    BASE_PATH=$BASE_PATH \
    API_SECRET=$API_SECRET \
    LOG_LEVEL=$LOG_LEVEL \
    DOTCOM_SFMC_BASEURL=$DOTCOM_SFMC_BASEURL \
    DOTCOM_SFMC_AUTH_CONSUMER_ID=$DOTCOM_SFMC_AUTH_CONSUMER_ID \
    DOTCOM_SFMC_AUTH_CONSUMER_SECRET=$DOTCOM_SFMC_AUTH_CONSUMER_SECRET \
    APPLICATIONINSIGHTS_CONNECTION_STRING=$APPLICATIONINSIGHTS_CONNECTION_STRING \
    TIP_TOKEN=$TIP_TOKEN \
    NEW_RELIC_APP_NAME=$NEW_RELIC_APP_NAME \
    NEW_RELIC_LICENSE_KEY=$NEW_RELIC_LICENSE_KEY \
    EMEID_AES_IV=$EMEID_AES_IV \
    EMEID_AES_KEY=$EMEID_AES_KEY

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.ts ./next.config.ts

EXPOSE 3000

CMD ["node_modules/.bin/next", "start"]