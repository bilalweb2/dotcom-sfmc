# -------------------------------------------------------
# .env.local
# Local development environment variables
# NEVER commit this file to Git
# -------------------------------------------------------
 
# -------------------------------------------------------
# MongoDB
# -------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/dotcom_sfmc
 
# -------------------------------------------------------
# Application
# -------------------------------------------------------
NODE_ENV=development
# Backend path
BASE_PATH=/ftr-forms
LOG_LEVEL=info
 
DOTCOM_SFMC_BASEURL=
DOTCOM_SFMC_AUTH_CONSUMER_ID=
DOTCOM_SFMC_AUTH_CONSUMER_SECRET=
 
APPLICATIONINSIGHTS_CONNECTION_STRING=
 
 
# -------------------------------------------------------
# Client-side configuration
# -------------------------------------------------------
# NEXT_PUBLIC_* variables are exposed to the browser.
# Do NOT put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_APP_URL=/ftr-forms
NEXT_PUBLIC_NODE_ENV=development
 
# -------------------------------------
# API Security
# -------------------------------------------------------
# Replace with a strong random secret.
API_SECRET=
 
 
# EMEID_AES_KEY accepts 64 hex chars (32 bytes) OR a Base64-encoded 32-byte value.
# EMEID_AES_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef01
EMEID_AES_KEY=AbCdEfGhIjKLMnoPQrsTUvwXYz1234567890ABCDEFI=
 
# EMEID_AES_IV accepts 32 hex chars (16 bytes) OR a Base64-encoded 16-byte value.
# When set, EMEID is treated entirely as ciphertext (fixed-IV mode).
# Test vector: EMEID=vVcez3yM9M3nm8l+PtOxqg== → test@test.com
EMEID_AES_IV=00000000000000000000000000000000
 